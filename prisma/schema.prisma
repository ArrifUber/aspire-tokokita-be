model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id               String   @id @default(uuid())
  code             String   @unique
  description      String?
  image            String?
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  name             String
  vendorId         String?  @map("vendor_id")
  vendor           Vendor?  @relation(fields: [vendorId], references: [id])
  commissionPercent Float    @default(0) @map("commission_percent")

  // buyPrice          Float
  sellPrice Float

  stock     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Update add minimum stock and active/inactive product
  isActive     Boolean @default(true)
  minimumStock Int     @default(5)

  boughtDetails   BoughtProductDetail[]
  stockIncrements StockIncrement[]

  @@map("products")
}

model StockIncrement {
  id        String   @id @default(uuid())
  productId String
  userId    String
  quantity  Int
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("stock_increments")
}

enum Role {
  OWNER
  CASHIER
  WAREHOUSE
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  // companyId String?  @map("company_id")
  // company   Company? @relation(fields: [companyId], references: [id])
  role      Role     @default(CASHIER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions    Transaction[]
  stockIncrements StockIncrement[]
  conversations   Conversation[]

  @@map("users")
}

model Transaction {
  id           String   @id @default(uuid())
  userId       String
  // companyId    String?  @map("company_id")
  // company      Company? @relation(fields: [companyId], references: [id])
  customerName String?
  totalPrice   Float
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // === INVOICE NUMBER ===

  invoiceNumber  String @unique @map("invoice_number") // hasil akhir: INV/20260902/TK01/0142
  invoicePrefix  String @default("INV") @map("invoice_prefix")
  sequenceNumber Int    @map("sequence_number") // nomor urut harian, contoh: 142

  user               User                @relation(fields: [userId], references: [id])
  detailTransactions DetailTransaction[]

  @@map("transactions")
}

model InvoiceCounter {
  id         String   @id @default(uuid())
  date       DateTime @unique @db.Date
  lastNumber Int      @default(0) @map("last_number")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("invoice_counters")
}

model DetailTransaction {
  id            String   @id @default(uuid())
  transactionId String
  totalCommission Float  @default(0) @map("total_commission") 
  discount      Float    @default(0)
  paymentAmount Float
  changeAmount  Float
  paymentMethod String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transaction    Transaction           @relation(fields: [transactionId], references: [id])
  boughtProducts BoughtProductDetail[]

  @@map("detail_transactions")
}

model BoughtProductDetail {
  id                  String   @id @default(uuid())
  detailTransactionId String
  productId           String
  vendorId            String?  @map("vendor_id") 
  name                String // Snapshot name
  code                String // Snapshot code
  sellPrice           Float // Snapshot sell price
  commissionPercent   Float    @default(0) @map("commission_percent") // snapshot komisi saat transaksi
  quantity            Int
  subtotal            Float
  createdAt           DateTime @default(now())

  detailTransaction DetailTransaction @relation(fields: [detailTransactionId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])

  @@map("bought_product_details")
}

model Conversation {
  id          String   @id @default(uuid())
  userId      String
  title       String   @default("New Conversation")
  lastMessage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  summaries Summary[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String
  token          Int?     @default(0)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  Attachment[]

  @@map("messages")
}

model Summary {
  id             String   @id @default(uuid())
  conversationId String
  summary        String
  lastMessageId  String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("summaries")
}

model Attachment {
  id        String   @id @default(uuid())
  messageId String
  filename  String
  mimeType  String
  url       String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Vendor {
  id   String @id @default(uuid())
  name String // Company name

  picName  String @map("pic_name")
  picPhone String @map("pic_phone")

  rekening   String @map("bank_name")
  noRekening String @map("no_rekening")

  jumlahProduk Int   @default(0) @map("jumlah_produk")
  isActive     Boolean @default(true) @map("is_active") // status

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("vendors")
}
